{
  "expo": {
    "name": "711 Ordering",
    "slug": "customer-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "customermobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F5F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seveneleven.ordering",
      "infoPlist": {
        // Required so push notifications can arrive while the app is
        // backgrounded (silent/content-available pushes).
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.seveneleven.ordering",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          // The API is plain HTTP on the LAN — Android blocks cleartext by
          // default since API 28, so opt back in until the API has HTTPS.
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow 711 Ordering to use your location to pick your delivery address.",
          "locationAlwaysAndWhenInUsePermission": "Allow 711 Ordering to use your location to pick your delivery address."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/711logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#007A53",
          "dark": {
            "image": "./assets/logos/711logo.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#007A53"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://192.168.254.191:5000/api", // dev default — production/preview builds override via EXPO_PUBLIC_API_URL in eas.json
      "router": {},
      "eas": {
        "projectId": "d844492f-87c8-4c11-925c-008265ecc30f"
      }
    },
    "owner": "zampat"
  }
}
