[TEMPLATE]
# ---------------------------------------------------------------
# 7-11 Online Ordering System — API server environment
# Copy this file to .env and fill in real values:
#   cp server/.env.example server/.env
#
# NOTE: config/env.js pins server/.env and OVERRIDES any same-named
# variable exported in your shell. If a value seems ignored, check
# .env first — the shell cannot beat it.
#
# ── DEPLOYING (Render / Railway / VPS) ─────────────────────────
# Set these in your host's dashboard (do NOT commit .env):
#   NODE_ENV=production
#   DB_URI=<MongoDB Atlas SRV string>
#   JWT_SECRET=<long random string — openssl rand -hex 32>
#   CORS_ORIGINS=https://<your-admin-domain>,https://<any-other-frontend>
#   CLOUDINARY_*  (required in production — uploads go to Cloudinary;
#                  the local /uploads disk is ephemeral on most hosts)
#   SMTP_*        (only if you want real OTP/reset emails)
# ---------------------------------------------------------------

# ── HTTP ────────────────────────────────────────────────────────
PORT=5000
# "production" disables dev-only endpoints (e.g. customer mark-delivered
# test route) and switches cookies to secure/sameSite=none (needs HTTPS)
NODE_ENV=development
# Extra CORS origins (comma-separated) beyond the built-in localhost/LAN
# dev defaults. REQUIRED in production, e.g.:
#   CORS_ORIGINS=https://711-admin.vercel.app
CORS_ORIGINS=

# ── Database (MongoDB) ─────────────────────────────────────────
# Local:  mongodb://localhost:27017/711
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/711
DB_URI=mongodb://localhost:27017/711

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Seeded superadmin account (npm run seed) ───────────────────
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me

# ── Email (SMTP) — leave SMTP_HOST empty for log-only mode ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display address on outgoing mail, e.g. "7-Eleven Ordering <noreply@example.com>"
EMAIL_FROM=

# ── Cloudinary (product image uploads) ─────────────────────────
# Required in production — image uploads (products, categories, promos,
# app-open ads, proof-of-delivery) are stored in Cloudinary, not on the
# server disk, which is ephemeral on Render/Railway/etc.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
