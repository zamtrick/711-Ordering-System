{
  "expo": {
    "name": "711 Rider",
    "slug": "rider-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ridermobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seveneleven.rider"
    },
    "android": {
      "package": "com.seveneleven.rider",
      "adaptiveIcon": {
        "backgroundColor": "#007A53",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          // The API is plain HTTP on the LAN — Android blocks cleartext by
          // default since API 28, so opt back in until the API has HTTPS.
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/711logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#007A53",
          "dark": {
            "image": "./assets/logos/711logo.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://192.168.254.181:5000/api",
      "router": {},
      "eas": {
        "projectId": "bf889e93-8e51-4071-9f04-f20a590672de"
      }
    },
    "owner": "zampat"
  }
}
